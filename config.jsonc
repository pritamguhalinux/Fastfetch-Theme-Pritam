{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        //"type": "chafa",
        "source": "/home/pritam/.config/fastfetch/jew-linux.png",
        "width": 35,
        "height": 19,
        "padding": {
            "right": 3
        }
    },

    "display": {
        "separator": " │ ",
    },

    "modules": [

        {
            "type": "custom",
            "format": "\u001b[34m                  Lord Pritam's Specification"
        },
        {
            "type": "custom",
            "format": "\u001b[36m╭──────────────────────────────────────────────────────────────╮"
        },

        {
            "type": "title",
            "format": "\u001b[36m│  \u001b[32m{user-name}@{host-name}"
        },

        {
            "type": "custom",
            "format": "\u001b[36m├──────────────────────────────────────────────────────────────┤"
        },

        {
            "type": "os",
            "key": "│  OS       "
        },

        {
            "type": "host",
            "key": "│  Host     "
        },

        {
            "type": "kernel",
            "key": "│  Kernel   "
        },

        {
            "type": "uptime",
            "key": "│  Uptime   "
        },

        {
            "type": "packages",
            "key": "│  Packages "
        },

        {
            "type": "shell",
            "key": "│  Shell    "
        },

        {
            "type": "terminal",
            "key": "│  Terminal "
        },

        {
            "type": "de",
            "key": "│  Desktop  "
        },

        {
            "type": "wm",
            "key": "│  WM       "
        },

        {
            "type": "cpu",
            "key": "│  CPU      "
        },

        {
            "type": "gpu",
            "key": "│  GPU      "
        },

        {
            "type": "memory",
            "key": "│  Memory   "
        },

        {
            "type": "disk",
            "key": "│  Disk     "
        },

        {
            "type": "custom",
            "format": "\u001b[36m├──────────────────────────────────────────────────────────────┤"
        },

        {
            "type": "colors",
            "key": "│\u001b[94m  Colors   ",
            "symbol": "circle"
        },

        {
            "type": "custom",
            "format": "\u001b[36m╰──────────────────────────────────────────────────────────────╯"
        },

        "break",

        {
            "type": "custom",
            "format": "\u001b[96m            ✡  עם ישראל חי  ✡"
        },

        {
            "type": "custom",
            "format": "        Shalom • Linux • Freedom"
        }
    ]
}
